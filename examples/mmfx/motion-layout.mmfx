/* Scene 0.3: image resources, row/column layout, keyframes, and a ticker. */
@scene motion-layout {
    width: 960px;
    height: 540px;
    background: #0d131c;

    @font Inter {
        src: "builtin:inter";
    }

    @group card {
        position: absolute;
        display: flex;
        flex-direction: row;
        left: 50px;
        top: 82px;
        width: 860px;
        height: 300px;
        padding: 38px;
        gap: 34px;
        align-items: center;
        background: #192737f2;
        border-radius: 28px;
        overflow: hidden;
        animation: enter 24f ease-out;

        @image mark {
            width: 190px;
            height: 190px;
            src: "../../docs/static/img/mmrecode-mark.png";
            object-fit: contain;
        }

        @group copy {
            display: flex;
            flex-direction: column;
            width: 560px;
            height: 190px;
            gap: 12px;
            justify-content: center;

            @text eyebrow {
                width: 100%;
                height: 30px;
                content: "SCENE 0.2";
                font-family: Inter;
                font-size: 20px;
                font-weight: 700;
                line-height: 1;
                color: #42d6c7;
                white-space: nowrap;
            }

            @text title {
                width: 100%;
                height: 64px;
                content: "Layout that moves.";
                font-family: Inter;
                font-size: 46px;
                font-weight: 700;
                line-height: 1.1;
                color: #f4f7f8;
                white-space: nowrap;
            }

            @text body {
                width: 100%;
                height: 52px;
                content: "Deterministic CPU rendering at exact local frame time.";
                font-family: Inter;
                font-size: 21px;
                font-weight: 430;
                line-height: 1.2;
                color: #a9b9ca;
                white-space: nowrap;
            }
        }
    }

    @group ticker-window {
        position: absolute;
        left: 50px;
        bottom: 42px;
        width: 860px;
        height: 58px;
        overflow: hidden;
        border-radius: 12px;
        background: #42d6c722;

        @text ticker {
            width: 920px;
            height: 58px;
            content: "MMRecode  •  hierarchical timeline  •  smart rendering  •  MMFX";
            font-family: Inter;
            font-size: 25px;
            font-weight: 600;
            line-height: 2.1;
            color: #e9f6f4;
            white-space: nowrap;
            mm-scroll-direction: inline-start;
            mm-scroll-range: cover;
            mm-scroll-duration: scene;
        }
    }
}

@keyframes enter {
    from {
        opacity: 0;
        transform: translateY(46px) scale(0.94);
    }
    70% {
        opacity: 1;
        transform: translateY(-4px) scale(1.01);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}
